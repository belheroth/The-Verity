{
  "name": "the-verity",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"cd frontend && vite\" \"node --watch server/server.js\"",
    "build": "npm --prefix frontend run build",
    "electron": "electron .",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.verity.app",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "!dist/win-unpacked/**/*",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/*.yml",
      "!dist/*.yaml"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": ["KioskLockHook.exe"]
      },
      {
        "from": "dist-server",
        "to": "dist-server",
        "filter": ["server-bundle.cjs"]
      },
      {
        "from": "server",
        "to": ".",
        "filter": ["database.json"]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
